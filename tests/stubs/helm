#!/bin/bash
# Stub helm for tests: logs and refuses, so an unexpected real deploy path is visible.
#   STUB_HELM_OK=1  succeed instead (tests/run_measured_autoscale_test.sh U9); a
#                   values file read from stdin (-f -) is not stored: only its
#                   size, whether it holds an apiKey line or a non-empty
#                   apiKey value, and the keyless/prestage/replicaCount
#                   switches are logged
#   STUB_HELM_FAIL_MATCH=TEXT  with STUB_HELM_OK=1: a call whose argv contains
#                   TEXT exits 1 (after reading stdin), e.g. "--wait-for-jobs"
echo "helm $*" >> "${STUB_LOG:-/dev/null}"
if [[ "${STUB_HELM_OK:-}" == "1" ]]; then
  # STUB_HELM_LIST=NAME: `helm list` reports release NAME as existing.
  if [[ "${1:-}" == "list" && -n "${STUB_HELM_LIST:-}" ]]; then echo "${STUB_HELM_LIST}"; exit 0; fi
  if [[ " $* " == *" -f - "* ]]; then
    in="$(cat)"
    has=no; [[ "${in}" == *"apiKey:"* ]] && has=yes
    # Non-empty apiKey value: a line apiKey: "<something>".
    val=no; grep -Eq 'apiKey: *"[^"]+"' <<< "${in}" && val=yes
    kl=no; grep -q 'keyless: true' <<< "${in}" && kl=yes
    ps=no; grep -A1 '^prestage:' <<< "${in}" | grep -q 'enabled: true' && ps=yes
    rc_=$(sed -n 's/^replicaCount: *//p' <<< "${in}")
    echo "helm-stdin bytes=${#in} apiKey_line=${has} apiKey_value=${val} keyless=${kl} prestage=${ps} replicas=${rc_:-default}" >> "${STUB_LOG:-/dev/null}"
  fi
  if [[ -n "${STUB_HELM_FAIL_MATCH:-}" && " $* " == *"${STUB_HELM_FAIL_MATCH}"* ]]; then
    echo "Error: stub failure (${STUB_HELM_FAIL_MATCH})" >&2; exit 1
  fi
  exit 0
fi
echo "helm stub: not available in tests" >&2
exit 1
